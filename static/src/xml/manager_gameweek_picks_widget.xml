<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fantasy_premier_league.ManagerGameweekPicks">
        <div class="fpl-formation-container o_fpl_manager_gameweek_picks">
            <div class="fpl-formation-header">
                <div class="fpl-formation-controls">
                    <div class="form-group">
                        <label for="fpl_manager_gw_select">Gameweek:</label>
                        <select id="fpl_manager_gw_select" class="form-control" t-att-disabled="state.loading" t-on-change="onGameweekChange">
                            <option t-foreach="state.gameweeks" t-as="gw" t-key="gw.id" t-att-value="gw.id" t-att-selected="gw.id == state.gameweek_id">
                                <t t-esc="gw.name"/>
                                <t t-if="gw.is_current"> (current)</t>
                            </option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-primary" t-att-disabled="state.loading" t-on-click="() => this.loadGameweek({ forceSync: true })">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                </div>
            </div>

            <div t-if="state.loading" class="d-flex flex-column align-items-center gap-2 py-5">
                <i class="fa fa-circle-o-notch fa-spin fa-2x text-primary"/>
                <span class="text-muted">Fetching gameweek picks...</span>
            </div>
            <t t-elif="hasPicks">
                <t t-call="fantasy_premier_league.GameweekPicksPitch"/>
            </t>
            <div t-elif="state.loaded" class="text-center text-muted py-5">
                No picks found for this gameweek.
            </div>
        </div>
    </t>
</templates>
