<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Points breakdown popup opened from the pitch view (replaces the former wizard) -->
    <record id="fpl_gameweek_pick_lines_stats_form_view" model="ir.ui.view">
        <field name="name">fpl.gameweek.pick.lines.stats.form</field>
        <field name="model">fpl.gameweek.pick.lines</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Player Stats" create="0" edit="0" delete="0">
                <sheet>
                    <field name="finished" invisible="1"/>
                    <field name="started" invisible="1"/>
                    <div class="oe_title mb24">
                        <h1>
                            <field name="element_id" class="text-break" readonly="1" options="{'no_open': True}"/>
                        </h1>
                        <div class="text-muted">
                            <field name="total_points" readonly="1" class="fw-bold"/> pts
                            <span invisible="multiplier &lt;= 1">(x<field name="multiplier" readonly="1" nolabel="1"/>)</span>
                        </div>
                    </div>
                    <div class="oe_title" style="text-align: center; padding: 20px 0;" invisible="not gw_fixture_id">
                        <field name="gw_fixture_id" invisible="1"/>
                        <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <div style="display: flex; flex-direction: column; align-items: center; margin: 0 30px;">
                                <div style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; border: 3px solid #E8E8E8; display: flex; align-items: center; justify-content: center; background: #F8F9FA; margin-bottom: 10px;">
                                    <field name="team_h_photo" widget="image" readonly="1"/>
                                </div>
                                <h2 style="margin: 0; color: #2C3E50;">
                                    <field name="team_h" readonly="1" options="{'no_open': True}"/>
                                </h2>
                                <small style="color: #7F8C8D;">Home</small>
                            </div>

                            <div style="display: flex; flex-direction: column; align-items: center; margin: 0 40px;">
                                <div invisible="not started" style="font-size: 3em; font-weight: bold; color: #000000; display: flex; align-items: center;">
                                    <field name="team_h_score" readonly="1" nolabel="1" style="min-width: 60px; text-align: center;"/>
                                    <span style="margin: 0 20px; color: #BDC3C7;">-</span>
                                    <field name="team_a_score" readonly="1" nolabel="1" style="min-width: 60px; text-align: center;"/>
                                </div>
                                <div invisible="started" style="font-size: 1.5em; font-weight: bold; color: #34495E; padding: 15px 25px; background: #ECF0F1; border-radius: 25px;">
                                    <field name="kickoff_time" readonly="1" widget="datetime" options="{'format': 'HH:mm'}"/>
                                </div>
                                <div style="margin-top: 10px; font-size: 14px; color: #7F8C8D;">
                                    <span invisible="not finished">Full Time</span>
                                </div>
                            </div>

                            <div style="display: flex; flex-direction: column; align-items: center; margin: 0 30px;">
                                <div style="width: 80px; height: 80px; border-radius: 50%; overflow: hidden; border: 3px solid #E8E8E8; display: flex; align-items: center; justify-content: center; background: #F8F9FA; margin-bottom: 10px;">
                                    <field name="team_a_photo" widget="image" readonly="1"/>
                                </div>
                                <h2 style="margin: 0; color: #2C3E50;">
                                    <field name="team_a" readonly="1" options="{'no_open': True}"/>
                                </h2>
                                <small style="color: #7F8C8D;">Away</small>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Points breakdown" name="points_breakdown">
                            <field name="element_stats_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="fixture_id" optional="hide"/>
                                    <field name="name" string="Statistic"/>
                                    <field name="value" string="Value"/>
                                    <field name="points" string="Points" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
