<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_get_boostrap_static" model="ir.cron">
        <field name="name">Cron Get Data from Boostrap Static API</field>
        <field name="model_id" ref="fantasy_premier_league.model_fpl_import_data"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model.cron_get_data_boostrap_static()</field>
        <field name="active">True</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
    </record>

    <record id="ir_cron_get_gameweek_fixtures" model="ir.cron">
        <field name="name">Cron Get Gameweek Fixutres Data API</field>
        <field name="model_id" ref="fantasy_premier_league.model_fpl_gameweek_fixtures"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model.cron_get_data_gameweek_fixutres(get_all=False, manual_gameweek=None, send_live_notifications=True)</field>
        <!-- 1 minute is the floor ir.cron can express - it is NOT the real
             live-tracking cadence. During a live match the job loops
             internally every ~15s and re-triggers itself right away (see
             cron_get_data_gameweek_fixutres's docstring). When nothing is
             being played the job does not call the API, apart from a full
             season refresh every 30 minutes. -->
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_cron_get_data_element_summary" model="ir.cron">
        <field name="name">Cron Get Elemment Summary Data API</field>
        <field name="model_id" ref="fantasy_premier_league.model_fpl_elements"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <!-- Processes the players in batches and re-runs itself until all of
             them are refreshed (ir.cron progress API), committing between
             batches. -->
        <field name="code">model.cron_get_data_element_summary()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <!-- Club badges, kits and player photos, stored in database. Only the
         missing images are downloaded; the bootstrap sync also triggers this
         job as soon as new clubs or players appear (new season). -->
    <record id="ir_cron_download_fpl_images" model="ir.cron">
        <field name="name">Cron Download FPL Images</field>
        <field name="model_id" ref="fantasy_premier_league.model_fpl_import_data"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model.cron_download_images()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_sync_manager_data" model="ir.cron">
        <field name="name">Cron Sync FPL Manager Data</field>
        <field name="model_id" ref="fantasy_premier_league.model_fpl_manager_team"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_manager_data()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
